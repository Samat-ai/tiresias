[Unit]
Description=Tiresias voice settings and performance dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tiresias
Group=tiresias
WorkingDirectory=/opt/tiresias/current
EnvironmentFile=/etc/tiresias/tiresias.env
ExecStart=/opt/tiresias/current/.venv/bin/python -m tiresias.app
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tiresias

[Install]
WantedBy=multi-user.target
