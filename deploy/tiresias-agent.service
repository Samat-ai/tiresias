[Unit]
Description=Tiresias LiveKit media worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=tiresias-call
Group=tiresias-call
WorkingDirectory=/opt/tiresias/current
EnvironmentFile=/etc/tiresias-call/media.env
Environment=HOME=/var/lib/tiresias-call
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/tiresias/current/src
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=AGENT_NUM_IDLE_PROCESSES=0
Environment=AGENT_HOST=127.0.0.1
Environment=AGENT_PORT=8081
ExecStart=/opt/tiresias/runtime/call-venv/bin/python -m tiresias.agent.main start
Restart=always
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
UMask=0077
StateDirectory=tiresias-call
StateDirectoryMode=0700
MemoryHigh=1400M
MemoryMax=1800M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tiresias-call

[Install]
WantedBy=multi-user.target
