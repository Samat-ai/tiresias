APP_ENV=development
APP_BASE_URL=http://localhost:8000
SERVICE_CONSENT_VERSION=2026-11-14.v1
DATABASE_URL=
TIMESCALE_SERVICE_URL=
TEST_DATABASE_URL=
MONGODB_URI=
MONGODB_DATABASE=tiresias
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=tiresias-agent
GEMINI_API_KEY=
GEMINI_MODEL=
# Use Vertex AI with locally stored ADC instead of AI Studio billing:
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional credentials JSON path; leave empty to use gcloud ADC login.
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=
ELEVEN_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2_realtime
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=
CHERT_PROJECT_ID=
CHERT_LINE_ID=
CHERT_API_KEY=
CHERT_INTEGRATION_MODE=cli
CHERT_FACETIME_API_BASE=https://facetime.trychert.com/api
CHERT_FACETIME_WEBHOOK_SECRET=
PRIVATE_SNAPSHOT_DIR=./data/snapshots
PHONE_DATA_ENCRYPTION_KEY=
# Random secret shared by the web service and local worker for voice-only caller links.
CALLER_LINK_SECRET=
# Optional override; the local worker otherwise reads ~/.chert/credentials.json.
CHERT_CREDENTIALS_FILE=
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_TREASURY_KEY_FILE=
SOLANA_REWARD_LAMPORTS=50000000
SOLANA_HELPER_WALLET=
ALLOW_REGISTRATION=false
ENABLE_BROWSER_DEMO=true
ENABLE_SUPPORT_BOT=false
ENABLE_IMESSAGE=false
ENABLE_BILLING=false
ENABLE_REWARDS=true
FRAME_MAX_LOCAL_AGE_MS=1000
VISION_TIMEOUT_SECONDS=8
VISUAL_EVIDENCE_MAX_AGE_MS=5000
EVIDENCE_TTL_SECONDS=1800
GROK_BOT_WEBHOOK_URL=
GROK_BOT_WEBHOOK_BEARER=
SESSION_SECRET=
